{
  "manifest_version": 3,
  "name": "Awwdit",
  "description": "Inspect live web pages and edit styles with a designer-friendly side panel.",
  "version": "0.1.1",
  "icons": {
    "16": "icons/awwdit-icon-16.png",
    "32": "icons/awwdit-icon-32.png",
    "48": "icons/awwdit-icon-48.png",
    "128": "icons/awwdit-icon-128.png"
  },
  "action": {
    "default_title": "Open Design Inspector",
    "default_icon": {
      "16": "icons/awwdit-icon-16.png",
      "32": "icons/awwdit-icon-32.png",
      "48": "icons/awwdit-icon-48.png",
      "128": "icons/awwdit-icon-128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
